---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';

const steps = [
  { n: '01', t: 'Заявка', d: 'Телефон, WhatsApp, Telegram или форма. Отвечаем в течение часа в рабочее время.' },
  { n: '02', t: 'Уточнение', d: 'Адрес, объём, вид работ, сроки, требования к людям. При необходимости — выезд на осмотр (для ремонта под ключ — обязательно).' },
  { n: '03', t: 'Цена и бригада', d: 'Называем точную цену и количество людей. Для юрлиц — договор, счёт, акт. Для частных — чек, расписка, безнал по QR.' },
  { n: '04', t: 'Выход на объект', d: 'Бригада в согласованный день. Бригадир отвечает за людей, задачу и качество.' },
  { n: '05', t: 'Приёмка и оплата', d: 'Оплата по факту после приёмки. Длинные объекты — поэтапно. Закрывающие документы для юрлиц.' }
];

const docs = [
  'Договор от ИП Таиров Г.К., без НДС',
  'Безнал на р/с, карта, наличные',
  'Постоплата по факту; для длинных объектов — поэтапно',
  'Регулярным B2B — рамочный договор и фиксированные ставки на квартал'
];

const resp = [
  'За сроки — выход в согласованный день, при задержке предупреждаем заранее',
  'За качество — исправляем по претензии; замена мастера в день обращения',
  'За людей — документы у всех; бригадир отвечает за дисциплину и порядок'
];

const noWay = [
  'Не берём предоплату за выход бригады',
  'Не отправляем людей без документов',
  'Не работаем без согласованного объёма и цены',
  'Не беремся за проектирование и согласования в госорганах — только работы'
];
---
<BaseLayout
  title="Как мы работаем — процесс, документы, ответственность | ГрузМаркет77"
  description="5 шагов: заявка, уточнение, цена, выход, оплата. Договор от ИП, безнал, постоплата, замена мастера по претензии. Чего мы не делаем."
>
  <div class="wrap"><Breadcrumbs items={[{ title: 'Как мы работаем' }]} /></div>

  <section class="hub-hero">
    <div class="wrap">
      <h1>Как мы работаем</h1>
      <p>Пять шагов от заявки до закрытых актов. Договор, безнал, оплата по факту. Прозрачно и без сюрпризов.</p>
    </div>
  </section>

  <section class="steps-section">
    <div class="wrap">
      <h2>Процесс</h2>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="num">{s.n}</div>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap three">
      <div>
        <h2>Документы и оплата</h2>
        <ul>{docs.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div>
        <h2>Ответственность</h2>
        <ul>{resp.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div>
        <h2>Чего мы не делаем</h2>
        <ul>{noWay.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <LeadForm heading="Готовы оставить заявку?" sub="Ответим за 15 минут." />
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero { padding: 32px 0 36px; }
  .hub-hero h1 { margin-bottom: 14px; }
  .hub-hero p { font-size: 17px; max-width: 820px; }

  .steps-section { padding: 32px 0 64px; }
  .steps-section h2 { margin-bottom: 28px; }
  .steps { display: grid; gap: 16px; }
  .step {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px 28px;
    align-items: start;
  }
  .num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 36px;
    color: var(--accent);
  }
  .step h3 { font-size: 18px; margin-bottom: 6px; }
  .step p { font-size: 15px; line-height: 1.6; }

  .block { padding: 64px 0; }
  .block.alt { background: var(--paper-soft); }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .three h2 { font-size: 22px; margin-bottom: 16px; }
  .three ul { list-style: none; display: grid; gap: 10px; }
  .three li {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .step { grid-template-columns: 56px 1fr; gap: 14px; padding: 18px 20px; }
    .num { font-size: 30px; }
    .three { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
