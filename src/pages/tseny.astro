---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceTable from '../components/PriceTable.astro';
import LeadForm from '../components/LeadForm.astro';
import prices from '../content/prices.json';

const rows = prices.rows.map((r) => [r.service, r.positions, r.price_from]);
---
<BaseLayout
  title="Цены на услуги — сводный прайс по 14 услугам | ГрузМаркет77"
  description="Прайс на все услуги: демонтаж, уборка, клининг, грузчики, отделка, электрика, монолит, дом под ключ, ландшафт. Цены от — по Москве, без материалов."
>
  <div class="wrap"><Breadcrumbs items={[{ title: 'Цены' }]} /></div>

  <section class="hub-hero">
    <div class="wrap">
      <h1>Сводный прайс по 14 услугам</h1>
      <p>Цены «от» — стартовая сетка по Москве 2026. Точная цена — после уточнения объёма. Для регулярных B2B-клиентов — фиксированные ставки на квартал.</p>
    </div>
  </section>

  <section class="price-block">
    <div class="wrap">
      <PriceTable head={['Услуга', 'Позиции', 'Цена «от»']} rows={rows} note={prices.note} />
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <LeadForm heading="Нужна точная смета?" sub="Опишите задачу — пришлём расчёт на вашу вилку." />
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero { padding: 32px 0 36px; }
  .hub-hero h1 { margin-bottom: 14px; }
  .hub-hero p { font-size: 17px; max-width: 820px; }
  .price-block { padding: 16px 0 64px; }
  .block { padding: 64px 0; }
  .block.alt { background: var(--paper-soft); }
</style>
