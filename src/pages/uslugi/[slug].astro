---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FaqList from '../../components/FaqList.astro';
import LeadForm from '../../components/LeadForm.astro';
import JsonLd from '../../components/JsonLd.astro';
import company from '../../content/company.json';

export async function getStaticPaths() {
  const items = await getCollection('services');
  return items.map((s) => ({ params: { slug: s.id }, props: { s } }));
}

const { s } = Astro.props;
const { Content } = await render(s);
const all = await getCollection('services');
const related = s.data.related
  .map((slug) => all.find((x) => x.id === slug))
  .filter(Boolean)
  .slice(0, 3);
const relCase = s.data.case_ref ? await getEntry('cases', s.data.case_ref) : null;

// FAQ страницы из body - вытащим секцию FAQ
const body = s.body ?? '';
const faqMatch = body.split(/^## FAQ\s*$/m)[1] ?? '';
const faqItems: { q: string; a: string }[] = [];
const faqRegex = /^- (.+?)\s+—\s+(.+?)(?=\n-|\n*$)/gms;
let m;
while ((m = faqRegex.exec(faqMatch)) !== null) {
  faqItems.push({ q: m[1].trim().replace(/\?$/, '?'), a: m[2].trim() });
}

const title = `${s.data.title} в Москве — цена ${s.data.price_from}, бригада ${s.data.brigade} | ГрузМаркет77`;
const desc = s.data.answer;
---
<BaseLayout title={title} description={desc}>
  <JsonLd type="Service" serviceName={s.data.title} description={desc} priceFrom={s.data.price_from} url={new URL(Astro.url.pathname, Astro.site).toString()} />

  <div class="wrap">
    <Breadcrumbs items={[{ title: 'Услуги', href: '/uslugi/' }, { title: s.data.title }]} />
  </div>

  <section class="svc-hero">
    <div class="wrap">
      <h1>{s.data.h1}</h1>
      <p class="aeo">{s.data.answer}</p>
      <div class="meta-row">
        <div class="meta"><span>Цена</span><strong>{s.data.price_from}</strong></div>
        <div class="meta"><span>Бригада</span><strong>{s.data.brigade}</strong></div>
        <div class="meta"><span>Срок</span><strong>{s.data.duration}</strong></div>
      </div>
      <div class="cta-row">
        <a href="/zayavka/" class="btn btn-primary">Оставить заявку →</a>
        <a href={`tel:${company.phone_tel}`} class="btn btn-ghost">{company.phone}</a>
      </div>
    </div>
  </section>

  <section class="svc-body">
    <div class="wrap grid">
      <article class="prose">
        <Content />
      </article>
      <aside class="aside">
        <div class="aside-form">
          <LeadForm compact heading="Задача есть — нужна бригада?" sub="Ответим за 15 минут, назовём цену и срок." />
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="block alt">
      <div class="wrap">
        <h2>Связанные услуги</h2>
        <div class="rel-grid">
          {related.map((r) => r && (
            <ServiceCard slug={r.id} title={r.data.title} price_from={r.data.price_from} answer={r.data.answer} />
          ))}
        </div>
      </div>
    </section>
  )}

  {relCase && (
    <section class="block">
      <div class="wrap">
        <h2>Пример работы</h2>
        <a class="case-link" href={`/kejsy/${relCase.id}/`}>
          <span class="case-tag">{relCase.data.tag}</span>
          <h3>{relCase.data.title}</h3>
          <div class="case-stats">
            <span>{relCase.data.duration}</span><span>·</span><span>{relCase.data.crew}</span><span>·</span><strong>{relCase.data.total.split('(')[0].trim()}</strong>
          </div>
        </a>
      </div>
    </section>
  )}

  {faqItems.length > 0 && (
    <section class="block alt">
      <div class="wrap">
        <h2>Частые вопросы по услуге</h2>
        <FaqList items={faqItems} />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .svc-hero { padding: 32px 0 48px; background: var(--paper-soft); }
  .svc-hero h1 { margin-bottom: 20px; }
  .aeo { font-size: 18px; line-height: 1.6; max-width: 820px; margin-bottom: 32px; color: var(--ink); }
  .meta-row { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .meta {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    min-width: 140px;
  }
  .meta span {
    display: block;
    font-size: 12px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: .3px;
    margin-bottom: 4px;
  }
  .meta strong {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--ink);
    font-size: 16px;
  }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }

  .svc-body { padding: 56px 0; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: start; }

  .prose :global(h2) {
    font-size: 24px;
    margin: 32px 0 16px;
  }
  .prose :global(h2):first-child { margin-top: 0; }
  .prose :global(p) { margin-bottom: 12px; }
  .prose :global(ul) { padding-left: 20px; margin-bottom: 16px; }
  .prose :global(li) { margin-bottom: 6px; color: var(--ink); }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 24px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .prose :global(thead th) {
    background: var(--ink);
    color: #fff;
    text-align: left;
    padding: 12px 16px;
    font-family: var(--font-heading);
    font-size: 13px;
    text-transform: uppercase;
  }
  .prose :global(tbody td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(tbody tr:nth-child(even)) { background: var(--paper-stripe); }

  .aside { position: sticky; top: 80px; }

  .block { padding: 56px 0; }
  .block.alt { background: var(--paper-soft); }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }

  .case-link {
    display: block;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-top: 20px;
    text-decoration: none;
    transition: all .2s;
  }
  .case-link:hover { box-shadow: var(--shadow-lift); }
  .case-tag {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 12px;
  }
  .case-link h3 { color: var(--ink); font-size: 22px; margin-bottom: 14px; }
  .case-stats {
    display: flex; gap: 10px; align-items: center;
    font-size: 14px; color: var(--ink-muted); flex-wrap: wrap;
  }
  .case-stats strong {
    color: var(--accent);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .aside { position: static; }
    .rel-grid { grid-template-columns: 1fr; }
  }
</style>
