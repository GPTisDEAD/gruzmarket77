---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CASES } from '../../data/site-map';
---
<BaseLayout
  title="Кейсы — примеры работ с цифрами | ГрузМаркет77"
  description="5 кейсов в масштабе реального чека: демонтаж, уборка, хелперы, санузел под ключ, абонентский клининг. Сроки, бригады, суммы."
>
  <section class="hub">
    <div class="wrap">
      <h1>Кейсы</h1>
      <p class="hub-note">Контент в разработке (corpus §8).</p>
      <ul class="hub-list">
        {CASES.map((c) => (
          <li><a href={`/kejsy/${c.slug}/`}>{c.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hub { padding: 80px 0 120px; }
  .hub h1 { margin-bottom: 12px; }
  .hub-note { margin-bottom: 32px; color: var(--ink-muted); }
  .hub-list { list-style: none; display: grid; gap: 12px; }
  .hub-list a {
    display: block;
    padding: 16px 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    transition: all .15s;
  }
  .hub-list a:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
</style>
