---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import JsonLd from '../components/JsonLd.astro';
import company from '../content/company.json';
---
<BaseLayout
  title="Контакты — телефон, WhatsApp, Telegram, email | ГрузМаркет77"
  description="Телефон, WhatsApp, Telegram, email. ИП Таиров Г.К. ИНН 050401330914. Москва и МО, заявки 8:00–22:00, выезды круглосуточно."
>
  <JsonLd type="LocalBusiness" />
  <div class="wrap"><Breadcrumbs items={[{ title: 'Контакты' }]} /></div>

  <section class="hub-hero">
    <div class="wrap">
      <h1>Контакты</h1>
      <p>{company.area}. {company.hours_requests}. {company.hours_dispatch}.</p>
    </div>
  </section>

  <section class="contacts">
    <div class="wrap grid">
      <div class="chan">
        <h2>Как связаться</h2>
        <ul class="chan-list">
          <li>
            <strong>Телефон</strong>
            <a href={`tel:${company.phone_tel}`}>{company.phone}</a>
          </li>
          <li>
            <strong>WhatsApp</strong>
            <a href={`https://wa.me/${company.whatsapp}`} rel="nofollow noopener">wa.me/{company.whatsapp}</a>
          </li>
          <li>
            <strong>Email</strong>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </li>
          {company.telegram && (
            <li>
              <strong>Telegram</strong>
              <a href={`https://t.me/${company.telegram}`} rel="nofollow noopener">@{company.telegram}</a>
            </li>
          )}
        </ul>

        <h3>Реквизиты</h3>
        <div class="req">
          <div><span>Наименование</span><strong>{company.name}</strong></div>
          <div><span>ИНН</span><strong>{company.inn}</strong></div>
          <div><span>ОГРНИП</span><strong>{company.ogrnip}</strong></div>
          <div><span>Банк</span><strong>{company.bank}</strong></div>
          <div><span>Расчётный счёт</span><strong>{company.account}</strong></div>
        </div>
      </div>
      <aside>
        <LeadForm compact heading="Или сразу заявкой" sub="Ответим в течение 15 минут." />
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero { padding: 32px 0 36px; }
  .hub-hero h1 { margin-bottom: 14px; }
  .hub-hero p { font-size: 17px; max-width: 820px; }

  .contacts { padding: 24px 0 72px; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; }
  .chan h2 { margin-bottom: 20px; }
  .chan h3 { margin: 32px 0 16px; font-size: 19px; }
  .chan-list { list-style: none; display: grid; gap: 12px; }
  .chan-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }
  .chan-list strong { font-family: var(--font-heading); font-size: 14px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: .3px; }
  .chan-list a { font-family: var(--font-heading); font-weight: 700; font-size: 16px; }

  .req {
    display: grid; gap: 10px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
  }
  .req div { display: grid; grid-template-columns: 180px 1fr; gap: 12px; font-size: 14px; }
  .req span { color: var(--ink-muted); }
  .req strong { color: var(--ink); font-family: var(--font-heading); font-weight: 600; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .req div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
