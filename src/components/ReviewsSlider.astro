---
import reviewsData from '../content/reviews.json';
const reviews = reviewsData.items;
---
<div class="rev-wrap">
  <div class="rev-head-row">
    <h2>Что говорят заказчики</h2>
    <div class="rev-nav">
      <button class="rev-btn" data-dir="-1" aria-label="Предыдущие отзывы">‹</button>
      <button class="rev-btn" data-dir="1" aria-label="Следующие отзывы">›</button>
    </div>
  </div>
  <div class="rev-track" tabindex="0" aria-label="Отзывы клиентов, листайте">
    {reviews.map((r) => (
      <article class="rev-card">
        <span class="rev-tag">{r.service}</span>
        <p class="rev-text">{r.text}</p>
        <div class="rev-author">
          <div class="rev-avatar">{r.name.split(' ').map((w) => w[0]).join('')}</div>
          <div>
            <strong>{r.name}</strong>
            <span>{r.role}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.rev-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.rev-track')!;
    wrap.querySelectorAll<HTMLButtonElement>('.rev-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.rev-card');
        const step = card ? card.offsetWidth + 20 : 340;
        track.scrollBy({ left: step * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .rev-head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 16px;
  }
  .rev-nav { display: flex; gap: 8px; }
  .rev-btn {
    width: 44px; height: 44px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    font-size: 22px;
    color: var(--ink);
    cursor: pointer;
    transition: all .15s;
    line-height: 1;
  }
  .rev-btn:hover { border-color: var(--accent); color: var(--accent); }

  .rev-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .rev-track::-webkit-scrollbar { display: none; }

  .rev-card {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .rev-tag {
    align-self: flex-start;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 14px;
  }
  .rev-text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink);
    flex: 1;
    margin-bottom: 20px;
  }
  .rev-author { display: flex; align-items: center; gap: 12px; }
  .rev-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 14px;
    flex-shrink: 0;
  }
  .rev-author strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--ink);
  }
  .rev-author span { font-size: 13px; color: var(--ink-muted); }

  @media (max-width: 900px) {
    .rev-card { flex: 0 0 85%; }
    .rev-btn { width: 40px; height: 40px; }
  }
</style>
