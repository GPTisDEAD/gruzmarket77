---
// Яндекс.Метрика. Включается переменной PUBLIC_YM_ID (номер счётчика).
// Код инициализации синхронизирован с официальным сниппетом Яндекса,
// добавлены webvisor, clickmap, trackLinks, ecommerce:dataLayer, SSR-флаг
// (у нас Astro SSG — страницы предрендерены).
const YM_ID = import.meta.env.PUBLIC_YM_ID || '';
---
{YM_ID && (
  <>
    <script is:inline define:vars={{ YM_ID }}>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=" + YM_ID, "ym");

      ym(Number(YM_ID), "init", {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: "dataLayer",
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true
      });
    </script>
    <noscript><div><img src={`https://mc.yandex.ru/watch/${YM_ID}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>
  </>
)}
